# GoPratle Backend Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/gopratle

# Allowed Client Origins for CORS (comma-separated list allowed)
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Environment Mode (development | production | test)
NODE_ENV=development

# Email / SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="GoPratle" <no-reply@gopratle.com>

# OTP HMAC Secret Key
OTP_SECRET=your_super_secret_otp_hmac_key_here

# Admin / Founder Portal Secret Key
ADMIN_SECRET=gopratle2026
